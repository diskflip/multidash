# Copy this file to .env (in the project root, next to package.json) and fill in.

# From your Kalshi account -> API Keys.
KALSHI_API_KEY_ID=

# Path to the RSA private key file downloaded when you created the API key.
KALSHI_PRIVATE_KEY_PATH=/absolute/path/outside/repository/kalshi-private-key.pem

# Usually fine to leave at the defaults below (see server/config.ts).
# KALSHI_REST_BASE_URL=https://external-api.kalshi.com
# KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
# MARKET_POLL_INTERVAL_MS=15000
# LOCAL_WS_PORT=4001

# The live trading bot's control API (multibot). Bot on/off and bet-size
# controls in the UI stay disabled until both are set. MULTIBOT_API_URL is
# multibot's own Cloudflare quick tunnel URL — temporary, changes on every
# multibot restart, so update it here when that happens.
# MULTIBOT_API_URL=https://<current-quick-tunnel>.trycloudflare.com
# CONTROL_TOKEN=

# Required for npm start: private dashboard login token (at least 32 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DASHBOARD_ACCESS_TOKEN=

# Jev advisory trial. Key stays on this server, never in VITE_* variables.
# With a key, enabled by default; false stops all Jev/book trial requests.
# TYPESAFE_API_KEY=
# JEV_ENABLED=false
# JEV_MODEL=jev-latest
# JEV_SYMBOLS=BTC,ETH,DOGE,SOL,XRP,BNB,ZEC,NEAR,HYPE
# JEV_INTERVAL_MS=5000
# JEV_LATE_INTERVAL_MS=5000
# JEV_MAX_CALLS_PER_MINUTE=600
# JEV_MAX_CALLS_PER_SESSION=7000
